<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Lighting — ODER × ReDo</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Josefin+Sans:wght@300;400&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
:root { --white: #fafaf8; --black: #111110; --gray: #8a8a85; --light: #e8e8e4; --accent: #c8b89a; }
html { scroll-behavior: smooth; }
body { background: var(--white); color: var(--black); font-family: 'Josefin Sans', sans-serif; font-weight: 300; letter-spacing: 0.04em; cursor: none; overflow-x: hidden; }
.cursor { position: fixed; width: 8px; height: 8px; background: var(--black); border-radius: 50%; pointer-events: none; z-index: 9999; transform: translate(-50%,-50%); transition: width .3s, height .3s; }
.cursor-ring { position: fixed; width: 36px; height: 36px; border: 1px solid var(--black); border-radius: 50%; pointer-events: none; z-index: 9998; transform: translate(-50%,-50%); transition: width .3s, height .3s, opacity .3s; opacity: .5; }
nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; display: flex; justify-content: space-between; align-items: center; padding: 32px 52px; background: rgba(250,250,248,0.92); backdrop-filter: blur(12px); }
.nav-logo { font-family: 'EB Garamond', serif; font-size: 15px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--black); text-decoration: none; }
.nav-links { display: flex; gap: 40px; list-style: none; }
.nav-links a { font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--black); text-decoration: none; opacity: 0.5; transition: opacity .3s; }
.nav-links a:hover, .nav-links a.active { opacity: 1; }
.ph-label { font-family: 'EB Garamond', serif; font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(80,70,60,0.35); text-align: center; }
.reveal { opacity: 0; transform: translateY(28px); transition: opacity .9s cubic-bezier(.25,.46,.45,.94), transform .9s cubic-bezier(.25,.46,.45,.94); }
.reveal.visible { opacity: 1; transform: translateY(0); }
.reveal-delay-1 { transition-delay: .12s; }
.reveal-delay-2 { transition-delay: .24s; }
.reveal-delay-3 { transition-delay: .36s; }
@keyframes fadeUp { from { opacity:0; transform:translateY(24px); } to { opacity:1; transform:translateY(0); } }
@keyframes fadeIn { from { opacity:0; } to { opacity:1; } }

/* PAGE HEADER */
.page-header {
  padding: 180px 52px 0;
  display: flex;
  flex-direction: column;
  gap: 48px;
}

.page-eyebrow {
  font-size: 11px;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--gray);
  opacity: 0;
  animation: fadeUp .8s ease .2s forwards;
}

.page-title {
  font-family: 'EB Garamond', serif;
  font-size: clamp(64px, 9vw, 130px);
  line-height: 0.9;
  font-weight: 400;
  opacity: 0;
  animation: fadeUp .9s ease .35s forwards;
}

.page-title em { font-style: italic; color: var(--gray); }

/* INTRO ROW */
.intro-row {
  padding: 60px 52px 80px;
  display: grid;
  grid-template-columns: 5fr 3fr;
  gap: 80px;
  align-items: start;
  border-top: 1px solid var(--light);
  margin-top: 48px;
}

.intro-body {
  font-size: 15px;
  letter-spacing: 0.06em;
  line-height: 2;
  color: var(--gray);
  max-width: 560px;
}

.intro-specs {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.spec-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  border-top: 1px solid var(--light);
  padding: 18px 0;
}

.spec-label { font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--gray); }
.spec-value { font-family: 'EB Garamond', serif; font-size: 16px; }

/* OPTION TABS */
.option-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  border-top: 1px solid var(--light);
  border-bottom: 1px solid var(--light);
}

.option-tab {
  padding: 40px 52px;
  border-right: 1px solid var(--light);
  display: flex;
  flex-direction: column;
  gap: 12px;
  text-decoration: none;
  color: var(--black);
  transition: background .3s;
  position: relative;
}

.option-tab:last-child { border-right: none; }

.option-tab::after {
  content: '';
  position: absolute;
  bottom: -1px; left: 0;
  width: 0; height: 2px;
  background: var(--black);
  transition: width .5s ease;
}

.option-tab:hover::after { width: 100%; }
.option-tab:hover { background: #f5f3ef; }

.tab-tag { font-size: 10px; letter-spacing: 0.25em; text-transform: uppercase; color: var(--accent); }
.tab-title { font-family: 'EB Garamond', serif; font-size: 28px; font-weight: 400; line-height: 1.1; }
.tab-desc { font-size: 12px; letter-spacing: 0.08em; line-height: 1.8; color: var(--gray); max-width: 340px; }
.tab-arrow { font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; margin-top: 8px; display: flex; align-items: center; gap: 10px; transition: gap .3s; }
.option-tab:hover .tab-arrow { gap: 16px; }

/* SECTION TITLE ROW */
.section-title-row {
  padding: 80px 52px 48px;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  border-top: 1px solid var(--light);
}

.section-heading {
  font-family: 'EB Garamond', serif;
  font-size: clamp(32px, 3.5vw, 48px);
  font-weight: 400;
  line-height: 1.1;
}

.section-heading em { font-style: italic; color: var(--gray); }

.section-note {
  font-size: 12px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--gray);
}

/* SHADES GRID */
.shades-grid {
  padding: 0 52px 100px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2px;
}

.shade-card {
  display: flex;
  flex-direction: column;
  background: var(--white);
  transition: background .3s;
  position: relative;
}

.shade-card:hover { background: #f5f3ef; }

.shade-img {
  width: 100%;
  overflow: hidden;
}

.shade-placeholder {
  width: 100%;
  height: 380px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform .7s cubic-bezier(.25,.46,.45,.94);
}

.shade-card:hover .shade-placeholder { transform: scale(1.04); }

.shade-card:nth-child(1) .shade-placeholder { background: linear-gradient(150deg, #ddd8d0 0%, #c8c0b4 100%); }
.shade-card:nth-child(2) .shade-placeholder { background: linear-gradient(160deg, #e0dcd4 0%, #ccc4b8 100%); }
.shade-card:nth-child(3) .shade-placeholder { background: linear-gradient(140deg, #d4cec6 0%, #c0b8ac 100%); }
.shade-card:nth-child(4) .shade-placeholder { background: linear-gradient(155deg, #d8d4cc 0%, #c4bcb0 100%); }
.shade-card:nth-child(5) .shade-placeholder { background: linear-gradient(145deg, #dcd8d0 0%, #c8c0b4 100%); }
.shade-card:nth-child(6) .shade-placeholder { background: linear-gradient(130deg, #d0ccc4 0%, #bdb8b0 100%); }

.shade-info {
  padding: 24px 28px 32px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.shade-number { font-size: 10px; letter-spacing: 0.25em; text-transform: uppercase; color: var(--accent); }
.shade-name { font-family: 'EB Garamond', serif; font-size: 22px; font-weight: 400; line-height: 1.2; }
.shade-desc { font-size: 12px; letter-spacing: 0.07em; line-height: 1.85; color: var(--gray); margin-top: 4px; flex: 1; }

.shade-specs {
  display: flex;
  gap: 20px;
  margin-top: 8px;
  flex-wrap: wrap;
}

.shade-spec {
  font-size: 10px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--gray);
  border: 1px solid var(--light);
  padding: 5px 10px;
}

.shade-footer {
  margin-top: 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid var(--light);
  padding-top: 16px;
}

.shade-avail { font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--gray); }
.shade-avail.sold { color: var(--accent); }

.shade-inquire {
  font-size: 11px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--black);
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: 8px;
  transition: gap .3s;
}
.shade-inquire:hover { gap: 14px; }

/* COMPLETE PENDANTS SECTION */
.pendants-section {
  padding: 0 52px 100px;
  border-top: 1px solid var(--light);
  padding-top: 0;
}

.pendants-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 2px;
  margin-top: 0;
}

.pendant-card {
  display: grid;
  grid-template-columns: 1fr 1fr;
  border: 1px solid var(--light);
  overflow: hidden;
  transition: background .3s;
}

.pendant-card:hover { background: #f8f6f3; }

.pendant-img {
  height: 360px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.pendant-img-inner {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform .7s ease;
}

.pendant-card:hover .pendant-img-inner { transform: scale(1.04); }

.pendant-card:nth-child(1) .pendant-img-inner { background: linear-gradient(150deg, #ddd8d0 0%, #c4bcb0 100%); }
.pendant-card:nth-child(2) .pendant-img-inner { background: linear-gradient(160deg, #d8d4cc 0%, #c0b8ac 100%); }
.pendant-card:nth-child(3) .pendant-img-inner { background: linear-gradient(140deg, #e0dcd4 0%, #ccc4b8 100%); }
.pendant-card:nth-child(4) .pendant-img-inner { background: linear-gradient(155deg, #d4d0c8 0%, #beb8b0 100%); }

.pendant-info {
  padding: 40px 36px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.pendant-tag { font-size: 10px; letter-spacing: 0.25em; text-transform: uppercase; color: var(--accent); }
.pendant-name { font-family: 'EB Garamond', serif; font-size: 26px; font-weight: 400; line-height: 1.2; }
.pendant-desc { font-size: 13px; letter-spacing: 0.07em; line-height: 1.85; color: var(--gray); flex: 1; }

.pendant-details {
  display: flex;
  flex-direction: column;
  gap: 0;
  border-top: 1px solid var(--light);
  padding-top: 20px;
}

.pendant-detail {
  display: grid;
  grid-template-columns: 1fr 1fr;
  padding: 10px 0;
  border-bottom: 1px solid var(--light);
}

.pendant-detail:last-child { border-bottom: none; }

.pd-label { font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gray); }
.pd-value { font-family: 'EB Garamond', serif; font-size: 15px; }

.pendant-cta {
  margin-top: 12px;
  display: inline-flex;
  align-items: center;
  gap: 14px;
  font-size: 11px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--black);
  text-decoration: none;
  border: 1px solid var(--black);
  padding: 14px 24px;
  width: fit-content;
  transition: background .4s, color .4s, gap .3s;
}
.pendant-cta:hover { background: var(--black); color: var(--white); gap: 20px; }

/* SHADE ONLY CALLOUT */
.shade-only-band {
  margin: 0 52px;
  padding: 48px 52px;
  background: #f5f3ef;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 40px;
  border: 1px solid var(--light);
}

.soc-text {}
.soc-label { font-size: 10px; letter-spacing: 0.25em; text-transform: uppercase; color: var(--accent); margin-bottom: 12px; }
.soc-heading { font-family: 'EB Garamond', serif; font-size: clamp(22px, 2.5vw, 32px); font-weight: 400; line-height: 1.2; }
.soc-heading em { font-style: italic; color: var(--gray); }
.soc-desc { font-size: 13px; letter-spacing: 0.07em; line-height: 1.8; color: var(--gray); margin-top: 12px; max-width: 480px; }

.soc-link {
  display: inline-flex;
  align-items: center;
  gap: 14px;
  font-size: 11px;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--black);
  text-decoration: none;
  border: 1px solid var(--black);
  padding: 16px 32px;
  flex-shrink: 0;
  transition: background .4s, color .4s, gap .3s;
}
.soc-link:hover { background: var(--black); color: var(--white); gap: 20px; }

/* CUSTOM / BESPOKE */
.bespoke-section {
  margin-top: 80px;
  padding: 100px 52px;
  background: var(--black);
  color: var(--white);
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}

.bespoke-heading {
  font-family: 'EB Garamond', serif;
  font-size: clamp(36px, 4vw, 60px);
  font-weight: 400;
  line-height: 1.1;
}

.bespoke-heading em { font-style: italic; color: var(--accent); }

.bespoke-content { display: flex; flex-direction: column; gap: 28px; }

.bespoke-body {
  font-size: 14px;
  letter-spacing: 0.08em;
  line-height: 2;
  color: rgba(250,250,248,0.6);
}

.bespoke-options {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.bespoke-option {
  display: grid;
  grid-template-columns: 48px 1fr;
  gap: 20px;
  align-items: start;
  padding: 20px 0;
  border-top: 1px solid rgba(255,255,255,0.1);
}

.bo-num { font-size: 10px; letter-spacing: 0.22em; color: var(--accent); padding-top: 2px; }
.bo-title { font-family: 'EB Garamond', serif; font-size: 18px; font-weight: 400; margin-bottom: 6px; }
.bo-text { font-size: 12px; letter-spacing: 0.07em; line-height: 1.8; color: rgba(250,250,248,0.55); }

.btn-light {
  display: inline-flex;
  align-items: center;
  gap: 16px;
  font-size: 11px;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--white);
  text-decoration: none;
  border: 1px solid rgba(255,255,255,0.4);
  padding: 18px 36px;
  transition: background .4s, border-color .4s, gap .3s;
  width: fit-content;
}
.btn-light:hover { background: rgba(255,255,255,0.08); border-color: var(--white); gap: 24px; }

/* FOOTER */
footer { padding: 80px 52px; border-top: 1px solid var(--light); display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 40px; align-items: end; }
.footer-logo { font-family: 'EB Garamond', serif; font-size: 28px; font-weight: 400; margin-bottom: 12px; }
.footer-tagline { font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--gray); }
.footer-nav { display: flex; flex-direction: column; gap: 14px; list-style: none; justify-self: center; }
.footer-nav a { font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--gray); text-decoration: none; transition: color .3s; }
.footer-nav a:hover { color: var(--black); }
.footer-right { justify-self: end; text-align: right; }
.footer-contact a { font-family: 'EB Garamond', serif; font-size: 18px; color: var(--black); text-decoration: none; display: block; margin-bottom: 6px; transition: color .3s; }
.footer-contact a:hover { color: var(--gray); }
.footer-social { margin-top: 20px; display: flex; gap: 20px; justify-content: flex-end; }
.footer-social a { font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gray); text-decoration: none; transition: color .3s; }
.footer-social a:hover { color: var(--black); }
.footer-bottom { grid-column: 1/-1; border-top: 1px solid var(--light); padding-top: 32px; display: flex; justify-content: space-between; }
.footer-bottom p { font-size: 11px; letter-spacing: 0.12em; color: var(--gray); text-transform: uppercase; }
</style>
</head>
